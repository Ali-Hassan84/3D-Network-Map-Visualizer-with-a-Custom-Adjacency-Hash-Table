{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run: netviz (sample dataset)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/netviz.exe",
      "args": ["data/sample_network.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "Build: netviz (Release)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Run: netviz (synthetic 1000 nodes)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/netviz.exe",
      "args": ["--synthetic", "1000", "42"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "Build: netviz (Release)"
    },
    {
      "name": "Debug: netviz (sample dataset)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/netviz.exe",
      "args": ["data/sample_network.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
      "preLaunchTask": "Build: netviz (Debug)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Run: tests",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/netviz_tests.exe",
      "args": [],
      "stopAtEntry": false,
